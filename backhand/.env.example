PORT=8000
MONOGOURL=mongodb://127.0.0.1:27017/hirehub
SECRET_KEY=your_jwt_secret_key_here
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Optional: Google Gemini API key for advanced AI ATS resume reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth 2.0 Credentials (Get from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
